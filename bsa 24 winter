```{r}
library(readr)
library(ggplot2)
library(googlesheets4)
library(gsheet)
data <- gsheet2tbl("https://docs.google.com/spreadsheets/d/1nhhzAvbhbsDv9FQd3XFr9ippG9tT_DHkm5yvNXX8HVs/edit?usp=sharing")

cor(data$`vmovement (kbo)`,data$`vmovement (mlb)`)
ggplot(data,aes(x=`hmovement (kbo) ab`,y=`hmovement (mlb)`))+geom_point()
cor(data$`hmovement (kbo) ab`,data$`hmovement (mlb)`)

ggplot(data, aes(x=data$`spin rate (kbo)`, y=data$`spin rate (mlb)`, color='1')) +
    geom_point(size=2) +
    geom_smooth(method="lm") +xlab("vertical movement (kbo)") +ylab("vertical movement (mlb)")

ggplot(data, aes(x=data$`exit velocity (kbo)`, y=data$`exit velocity (mlb)`, color='1')) +
    geom_point(size=2) +
    geom_smooth(method="lm") +xlab("vertical movement (kbo)") +ylab("vertical movement (mlb)")

ggplot(data, aes(x=data$`hardhit rate (kbo)`, y=data$`hardhit rate (kbo)`, color='1')) +
    geom_point(size=2) +
    geom_smooth(method="lm") +xlab("vertical movement (kbo)") +ylab("vertical movement (mlb)")

ggplot(data, aes(x=data$`vmovement (kbo)`, y=data$`vmovement (mlb)`, color='1')) +
    geom_point(size=2) +
    geom_smooth(method="lm") +xlab("vertical movement (kbo)") +ylab("vertical movement (mlb)")
summary(lm(data$`vmovement (mlb)` ~ data$`vmovement (kbo)`))$coefficients           

ggplot(data, aes(x=data$`hmovement (kbo) ab`, y=data$`hmovement (mlb)`, color='1')) +
    geom_point(size=2) +
    geom_smooth(method="lm") +xlab("horiztonal movement (kbo)") +ylab("horiztonal movement (mlb)")
summary(lm(data$`hmovement (mlb)` ~ data$`hmovement (kbo) ab`))$coefficients  
